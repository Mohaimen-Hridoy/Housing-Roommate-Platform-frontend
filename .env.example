# ---------------------------------------------------------------------------
# Housing & Roommate Platform — Frontend environment
# Copy to `.env.local` and adjust. NEVER commit the real `.env.local`.
# ---------------------------------------------------------------------------

# Base URL of the B7A6 backend (server-side; used by Route Handlers + RSC).
# Local: http://localhost:4000  |  Deployed: https://housing-roommate-platform-backend.vercel.app
API_BASE_URL=https://housing-roommate-platform-backend.vercel.app

# Same value, exposed to the browser. Only needed if you talk to the API
# directly from the client instead of through the internal /api/proxy route.
NEXT_PUBLIC_API_BASE_URL=https://housing-roommate-platform-backend.vercel.app

# Mount point of the backend's versioned API. Keep as-is for the B7A6 API.
NEXT_PUBLIC_API_PREFIX=/api/v1

# Stripe (test mode). Only the publishable key is needed in the browser;
# the secret key and webhook secret live on the backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public site URL, used for metadata / Open Graph absolutes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
